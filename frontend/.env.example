# Postgres connection string used by Prisma.
# Local example: postgresql://postgres:postgres@localhost:5432/innkeeper
# Or use a free hosted instance (Neon, Supabase, Railway).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/innkeeper"

# Secret used to sign the short-lived guest check-in JWT.
CHECKIN_JWT_SECRET="replace-with-a-long-random-string"

# Base URL used by the scheduler to build check-in email links.
# In production, set this to your public domain (e.g. https://checkin.yourhotel.com)
APP_BASE_URL=http://localhost:3000
